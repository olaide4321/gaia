  "lines": [
    {"id": "vo-01", "act": "problem",     "from": 24,   "to": 132,  "text": "Humanity learned to build intelligence."},
    {"id": "vo-02", "act": "problem",     "from": 140,  "to": 292,  "text": "But what happens when the world needs more computing power than it can afford?"},
    {"id": "vo-03", "act": "idle",        "from": 318,  "to": 462,  "text": "Across the world, computing power sits unused,"},
    {"id": "vo-04", "act": "idle",        "from": 466,  "to": 646,  "text": "while innovators struggle to access the resources they need."},
    {"id": "vo-05", "act": "discovery",   "from": 690,  "to": 832,  "text": "What if these scattered resources could work together?"},
    {"id": "vo-06", "act": "discovery",   "from": 864,  "to": 1124, "text": "io.net brings distributed GPU resources together through a decentralized computing network."},
    {"id": "vo-07", "act": "possibility", "from": 1158, "to": 1330, "text": "Because the next breakthrough might not require building everything from scratch."},
    {"id": "vo-08", "act": "possibility", "from": 1340, "to": 1490, "text": "It might begin with connecting what already exists."},
    {"id": "vo-09", "act": "reveal",      "from": 1512, "to": 1612, "text": "The world doesn't just need more intelligence."},
    {"id": "vo-10", "act": "reveal",      "from": 1618, "to": 1720, "text": "It needs more ways to power it."}
  ]
}
