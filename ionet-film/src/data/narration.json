  "lines": [
    {"id": "vo-01", "act": "problem", "from": 10, "to": 120, "text": "Humanity learned to build intelligence.", "highlight": ["intelligence"]},
    {"id": "vo-02", "act": "problem", "from": 122, "to": 260, "text": "But what happens when the world needs more computing power than it can afford?", "highlight": ["computing power", "afford"]},
    {"id": "vo-03", "act": "idle", "from": 262, "to": 434, "text": "Across the world, computing power sits unused, while innovators struggle to reach it.", "highlight": ["sits unused"]},
    {"id": "vo-04", "act": "discovery", "from": 436, "to": 527, "text": "What if these scattered resources could work together?", "highlight": ["work together"]},
    {"id": "vo-05", "act": "discovery", "from": 529, "to": 738, "text": "io.net brings distributed GPU resources together through a decentralized computing network.", "highlight": ["io.net", "decentralized computing network"]},
    {"id": "vo-06", "act": "possibility", "from": 786, "to": 927, "text": "The next breakthrough might begin with connecting what already exists.", "highlight": ["connecting what already exists"]},
    {"id": "vo-07", "act": "reveal", "from": 978, "to": 1078, "text": "The world doesn't just need more intelligence.", "highlight": ["intelligence"]},
    {"id": "vo-08", "act": "reveal", "from": 1080, "to": 1192, "text": "It needs more ways to power that intelligence.", "highlight": ["power that intelligence"]}
