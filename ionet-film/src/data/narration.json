  "lines": [
    {"id": "vo-01", "act": "problem",     "from": 15,   "to": 100,  "text": "Humanity learned to build intelligence."},
    {"id": "vo-02", "act": "problem",     "from": 106,  "to": 238,  "text": "But what happens when the world needs more computing power than it can afford?"},
    {"id": "vo-03", "act": "idle",        "from": 249,  "to": 416,  "text": "Across the world, computing power sits unused, while innovators struggle to reach it."},
    {"id": "vo-04", "act": "discovery",   "from": 438,  "to": 533,  "text": "What if these scattered resources could work together?"},
    {"id": "vo-05", "act": "discovery",   "from": 543,  "to": 778,  "text": "io.net brings distributed GPU resources together through a decentralized computing network."},
    {"id": "vo-06", "act": "possibility", "from": 798,  "to": 920,  "text": "The next breakthrough might begin with connecting what already exists."},
    {"id": "vo-07", "act": "reveal",      "from": 1005, "to": 1094, "text": "The world doesn't just need more intelligence."},
    {"id": "vo-08", "act": "reveal",      "from": 1098, "to": 1180, "text": "It needs more ways to power it."}
  ]
