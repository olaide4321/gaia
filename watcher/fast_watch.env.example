# Copy to watcher/.env on your server and fill in. Never commit .env.
API_URL=
# Headers copied from the browser request, as JSON. Keep this secret.
API_HEADERS={"Authorization": "Bearer PASTE_TOKEN_HERE"}
ITEMS_PATH=
ID_FIELD=id
TITLE_FIELDS=title,name
LINK_TEMPLATE=https://subsgigs-alpha.vercel.app/campaigns/{id}
POLL_SECONDS=3
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
